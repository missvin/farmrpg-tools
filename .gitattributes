* text=auto

# Keep source and config files normalized as LF in the repository and working tree.
.gitattributes text eol=lf
.editorconfig text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.sh text eol=lf

# Keep Windows command wrappers compatible with native shells.
*.bat text eol=crlf
*.cmd text eol=crlf
